# 1. PostgreSQL Connection String (Optional)
# - Nếu để trống hoặc comment dòng dưới: Hệ thống tự động fallback sang PGlite nhúng tại ./database/pgdata
# - Nếu khai báo: Hệ thống ưu tiên kết nối thẳng tới PostgreSQL Server (Local hoặc Cloud Supabase/Neon)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hub_docs

# 2. Admin Passkey (Dùng để đăng nhập chế độ Quản trị viên Thêm/Sửa/Xóa Prompt trên UI)
ADMIN_PASSKEY=aihub-admin-2026
